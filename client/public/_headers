# Security headers for every page and file. Cloudflare applies this to static assets;
# the Worker (worker/index.ts) only answers /api/* and sets its own headers there.
# The policy allows only what the site loads: its own files (fonts included), YouTube's
# no-cookie player, and Cloudflare Web
# Analytics, which Cloudflare injects on the live domain, and Cloudflare Turnstile (the form
# human check, loaded only once the Worker has its keys).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self' https://cloudflareinsights.com https://challenges.cloudflare.com; frame-src https://www.youtube-nocookie.com https://challenges.cloudflare.com; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Built files carry a hash of their content in the name, so a changed file gets a new address.
# Browsers can keep them for a year without asking again.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
