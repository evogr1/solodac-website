{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "solodac-website",
  "compatibility_date": "2026-09-18",
  "main": "worker/index.ts",
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAF09iHH9ZxzpxQiI"
  },
  "kv_namespaces": [
    { "binding": "EVENTS", "id": "b6e79e3d815a431f9645a45977c7a75d" }
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist/public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/marketing",
      "/eyeballs",
      "/youtube",
      "/clipping",
      "/studio",
      "/services/*",
      "/approach",
      "/careers",
      "/thesis",
      "/stories",
      "/stories/*",
      "/events",
      "/campaigns",
      "/case-studies",
      "/testimonials",
      "/portfolio",
      "/fireyoureditor",
      "/tools",
      "/chop-shop"
    ],
    "not_found_handling": "404-page"
  }
}
